# Copy to .env and fill in real values. NEVER commit .env to git.

# MongoDB connection string (local Mongo or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/smartrent

# Long random string used to sign JWTs (generate with: openssl rand -hex 32)
JWT_SECRET=replace_this_with_a_long_random_secret

# Port the API server listens on
PORT=5000

# Comma-separated list of origins allowed to call the API (your frontend dev URL)
CLIENT_ORIGIN=http://localhost:5173

# OpenAI API key for the chatbot feature. Only used server-side, never sent to the browser.
OPENAI_API_KEY=replace_with_your_openai_key
